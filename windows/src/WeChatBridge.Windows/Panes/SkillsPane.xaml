<UserControl x:Class="WeChatBridge.Windows.Panes.SkillsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Status filter chips — the port of SkillStatusFilterBar. Tag=Selected marks the active one. -->
        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource InkSecondaryColor}" />
            <Setter Property="Background" Value="{StaticResource SunkenColor}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chip" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource StrokeColor}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="Foreground" Value="{StaticResource InkColor}" />
                    <Setter Property="Background" Value="{StaticResource BrandTintColor}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 官方技能 / 用于 N 个场景 capsules — the port of SkillBadge. -->
        <Style x:Key="SkillBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SunkenColor}" />
        </Style>

        <!-- One skill card: mark, name+summary, pill, badges, action, expandable agent rows. -->
        <DataTemplate x:Key="SkillCardTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Disclosure — the ▸/▾ toggle macOS hangs off the details button. -->
                        <Button Grid.Column="0" VerticalAlignment="Top" Padding="4" Margin="0,2,6,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="ToggleDetails_Click" ToolTip="展开或收起详情">
                            <TextBlock FontSize="11" Foreground="{StaticResource InkTertiaryColor}"
                                       Text="{Binding IsExpanded, Converter={StaticResource ExpandGlyph}}" />
                        </Button>

                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8"
                                Background="{StaticResource BrandTintColor}" VerticalAlignment="Top">
                            <TextBlock FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding Mark}" />
                        </Border>

                        <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkColor}" Text="{Binding Skill.Name}" />
                                <TextBlock Margin="6,0,0,0" FontSize="11" VerticalAlignment="Bottom"
                                           Foreground="{StaticResource InkTertiaryColor}"
                                           Text="{Binding Skill.Version, StringFormat={}v{0}}" />
                            </StackPanel>
                            <TextBlock Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkSecondaryColor}"
                                       Text="{Binding Skill.Summary}" />
                        </StackPanel>

                        <Border Grid.Column="3" Style="{StaticResource StatusPill}"
                                VerticalAlignment="Top" Margin="10,0,0,0">
                            <TextBlock Style="{StaticResource StatusPillText}" Text="{Binding StatusTitle}" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource SkillBadge}">
                                <TextBlock FontSize="11" Foreground="{StaticResource InkSecondaryColor}"
                                           Text="官方技能" />
                            </Border>
                            <Border Style="{StaticResource SkillBadge}">
                                <TextBlock FontSize="11" Foreground="{StaticResource InkSecondaryColor}"
                                           Text="{Binding SceneCount, StringFormat={}用于 {0} 个场景}" />
                            </Border>
                            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource InkTertiaryColor}"
                                       Text="{Binding CoverageText}"
                                       Visibility="{Binding ShowCoverage, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource SettingsButton}" Padding="10,3" FontSize="11.5"
                                Content="{Binding PrimaryTitle}" IsEnabled="{Binding Ready}"
                                Click="CardPrimary_Click" />
                    </Grid>

                    <!-- Per-agent rows — SkillAgentRow, expanded on demand. -->
                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <Border Height="1" Margin="0,10,0,6" Background="{StaticResource StrokeSoftColor}" />

                        <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                                Background="{StaticResource WarnFillColor}"
                                Visibility="{Binding PackageMissing, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource WarnInkColor}"
                                       Text="技能包尚未随当前构建提供；场景仍可转发，提示词会要求 Agent 在不可用时说明未完成部分。" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding States}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="30" Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource BrandTintColor}">
                                            <TextBlock FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrandColor}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Text="{Binding AgentMark}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="12.5"
                                                   VerticalAlignment="Center" Foreground="{StaticResource InkColor}"
                                                   Text="{Binding AgentName}" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Style="{StaticResource StatusPill}" ToolTip="{Binding StatusDetail}">
                                            <TextBlock Style="{StaticResource StatusPillText}"
                                                       Text="{Binding StatusText}" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Margin="10,0,0,0" FontSize="11"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource InkTertiaryColor}"
                                                   Text="{Binding StatusDetail}" />

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource InkTertiaryColor}" Text="处理中…"
                                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource InkTertiaryColor}" Text="未检测到应用"
                                                       Visibility="{Binding ShowAgentMissing, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Margin="6,0,0,0" Style="{StaticResource SettingsButton}"
                                                    Padding="8,2" FontSize="11" IsEnabled="{Binding Ready}"
                                                    Content="{Binding InstallTitle}"
                                                    Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVisibility}}"
                                                    Click="AgentInstall_Click" />
                                            <Button Margin="6,0,0,0" Style="{StaticResource SettingsButton}"
                                                    Padding="8,2" FontSize="11" IsEnabled="{Binding Ready}"
                                                    Content="替换"
                                                    Visibility="{Binding ShowReplace, Converter={StaticResource BoolToVisibility}}"
                                                    Click="AgentReplace_Click" />
                                            <Button Margin="6,0,0,0" Style="{StaticResource SettingsButton}"
                                                    Padding="8,2" FontSize="11" IsEnabled="{Binding Ready}"
                                                    Content="移除"
                                                    Visibility="{Binding ShowUninstall, Converter={StaticResource BoolToVisibility}}"
                                                    Click="AgentUninstall_Click" />
                                            <Button Margin="6,0,0,0" Style="{StaticResource SettingsButton}"
                                                    Padding="8,2" FontSize="11" IsEnabled="{Binding Ready}"
                                                    Content="导出 ZIP"
                                                    Visibility="{Binding ShowManualActions, Converter={StaticResource BoolToVisibility}}"
                                                    Click="AgentExport_Click" />
                                            <Button Margin="6,0,0,0" Style="{StaticResource SettingsButton}"
                                                    Padding="8,2" FontSize="11" IsEnabled="{Binding Ready}"
                                                    Content="{Binding ConfirmTitle}"
                                                    Visibility="{Binding ShowManualActions, Converter={StaticResource BoolToVisibility}}"
                                                    Click="AgentConfirm_Click" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Root" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980">
            <TextBlock FontSize="13" Foreground="{StaticResource InkSecondaryColor}"
                       Text="发现、安装和管理各 Agent 可用的技能。" TextWrapping="Wrap" />

            <!-- Catalog load failure — the loadError line on macOS. -->
            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                    Background="{StaticResource WarnFillColor}"
                    Visibility="{Binding LoadError, Converter={StaticResource StringToVisibility}}">
                <TextBlock FontSize="12" Foreground="{StaticResource WarnInkColor}"
                           Text="{Binding LoadError}" TextWrapping="Wrap" />
            </Border>

            <!-- Metrics — the three SkillMetricCard boxes. -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource BrandColor}" Text="◇" />
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource InkColor}"
                                   Text="{Binding SkillCount, StringFormat={}{0} 个技能}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource WarnInkColor}" Text="△" />
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource InkColor}"
                                   Text="{Binding PendingInstallCount, StringFormat={}{0} 项待安装}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource InkTertiaryColor}" Text="◎" />
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource InkColor}"
                                   Text="{Binding SupportedAgentCount, StringFormat={}{0} 个 Agent}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Search + agent filter — SkillSearchField and the Agent select. -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" VerticalAlignment="Center" Padding="8,5" FontSize="12"
                         ToolTip="搜索技能名、描述或标识" TextChanged="Search_Changed" />
                <ComboBox x:Name="AgentBox" Grid.Column="1" Width="170" Margin="8,0,0,0"
                          VerticalAlignment="Center" Padding="6,3"
                          SelectionChanged="Agent_Changed" />
            </Grid>

            <!-- Status chips with counts, mirroring SkillStatusFilterBar. -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="FilterAll" Style="{StaticResource FilterChip}" Click="FilterAll_Click" />
                <Button x:Name="FilterMissing" Margin="6,0,0,0" Style="{StaticResource FilterChip}"
                        Click="FilterMissing_Click" />
                <Button x:Name="FilterPartial" Margin="6,0,0,0" Style="{StaticResource FilterChip}"
                        Click="FilterPartial_Click" />
                <Button x:Name="FilterDone" Margin="6,0,0,0" Style="{StaticResource FilterChip}"
                        Click="FilterDone_Click" />
            </StackPanel>

            <!-- 安装全部缺失项 + the manual-path caveat. -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource SettingsButton}" IsEnabled="{Binding CanInstallAll}"
                        Click="InstallAll_Click">
                    安装全部缺失项
                </Button>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource InkTertiaryColor}"
                           Text="仅处理支持直接安装的 Agent；其余仍需导出 ZIP。" />
            </StackPanel>

            <!-- Skill cards. -->
            <ItemsControl x:Name="SkillList" Margin="0,12,0,0"
                          ItemTemplate="{StaticResource SkillCardTemplate}" />

            <!-- Empty state, mirroring the puzzlepiece placeholder. -->
            <StackPanel x:Name="EmptyState" Margin="0,40" Visibility="Collapsed">
                <TextBlock FontSize="22" HorizontalAlignment="Center"
                           Foreground="{StaticResource InkTertiaryColor}" Text="◇" />
                <TextBlock Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{StaticResource InkColor}" Text="没有找到匹配的技能。" />
            </StackPanel>

            <!-- Inline notice — the port of the macOS Notice banner. -->
            <Border x:Name="NoticeBar" Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                    Background="{StaticResource LiveFillColor}" Visibility="Collapsed">
                <TextBlock x:Name="NoticeText" FontSize="12" Foreground="{StaticResource LiveInkColor}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
