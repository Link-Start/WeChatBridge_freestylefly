<UserControl x:Class="WeChatBridge.Windows.Panes.ScenesPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Segmented page buttons — the port of macOS pagePicker. -->
        <Style x:Key="PageTab" TargetType="Button">
            <Setter Property="Padding" Value="0,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkSecondaryColor}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fill" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="Foreground" Value="{StaticResource InkColor}" />
                    <Setter Property="Background" Value="{StaticResource BrandTintColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- List rows that behave like buttons but keep their own text styling. -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Padding="{TemplateBinding Padding}"
                                Background="Transparent" CornerRadius="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource BrandTintColor}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource HoverColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Link-style button, e.g. 导入 JSON. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrandColor}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980">
            <TextBlock FontSize="13" Foreground="{StaticResource InkSecondaryColor}"
                       Text="管理转发时附加的提示词，以及它们适用的 Agent。"
                       TextWrapping="Wrap" />

            <!-- 场景管理 / 群聊匹配 — the segmented pagePicker. -->
            <Border Width="300" Margin="0,14,0,0" Padding="2" CornerRadius="8"
                    Background="{StaticResource SunkenColor}"
                    BorderBrush="{StaticResource StrokeColor}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ScenesTab" Content="场景管理" Tag="Selected"
                            Style="{StaticResource PageTab}" Click="ShowScenesPage_Click" />
                    <Button x:Name="GroupsTab" Grid.Column="1" Content="群聊匹配"
                            Style="{StaticResource PageTab}" Click="ShowGroupsPage_Click" />
                </Grid>
            </Border>

            <!-- =============== 场景管理 page =============== -->
            <Grid x:Name="ScenesPage" Margin="0,10,0,0" MinHeight="480">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Scene list card. -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0"
                        AllowDrop="True" Drop="SceneList_Drop" DragOver="SceneList_DragOver">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="场景" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkColor}" />
                            <TextBlock x:Name="SceneCount" Grid.Column="1" Margin="6,0,0,0"
                                       FontSize="11" Foreground="{StaticResource InkTertiaryColor}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource SettingsButton}"
                                    Padding="10,3" FontSize="11.5" Content="新建"
                                    Click="AddScene_Click" />
                        </Grid>

                        <TextBox x:Name="SceneSearch" Grid.Row="1" Margin="14,0,14,8"
                                 Padding="8,5" FontSize="12" ToolTip="搜索场景"
                                 TextChanged="SceneSearch_TextChanged" />
                        <Border Grid.Row="2" Height="1" Background="{StaticResource StrokeSoftColor}" />

                        <ListBox x:Name="SceneList" Grid.Row="3" BorderThickness="0"
                                 Background="Transparent" MinHeight="240" MaxHeight="430"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource RowItem}"
                                 SelectionChanged="SceneList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Margin="2,7,0,0"
                                                 VerticalAlignment="Top"
                                                 Fill="{StaticResource InkTertiaryColor}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource InkTertiaryColor}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource BrandColor}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding NameText}" FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkColor}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SummaryText}" FontSize="11"
                                                       Foreground="{StaticResource InkSecondaryColor}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" FontSize="10.5"
                                                   Foreground="{StaticResource InkTertiaryColor}"
                                                   Text="{Binding Hotkey}"
                                                   Visibility="{Binding Hotkey, Converter={StaticResource StringToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="4" Margin="14,8,14,12">
                            <Button Content="导入 JSON" Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Left" Click="Import_Click" />
                            <TextBlock Margin="0,6,0,0" FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkTertiaryColor}"
                                       Text="快捷键：Ctrl+Alt+1–9 把对应的启用场景用于下次转发；可把场景包 JSON 拖进此列表导入。" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Scene detail — the embedded port of macOS SceneEditor. -->
                <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel x:Name="EditorEmpty" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="选择一个场景" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkColor}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkSecondaryColor}"
                                       Text="在左侧选择场景后，可以查看说明、启停和编辑。"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer x:Name="EditorContent" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="EditorTitle" FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkColor}" />
                                        <TextBlock x:Name="EditorStatus" Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource InkTertiaryColor}" />
                                    </StackPanel>
                                    <CheckBox x:Name="EnableBox" Grid.Column="1"
                                              VerticalAlignment="Center" Margin="10,0,0,0"
                                              Content="启用" FontSize="12"
                                              Foreground="{StaticResource InkColor}"
                                              Click="Enable_Click" />
                                    <Button x:Name="EditorMenu" Grid.Column="2"
                                            VerticalAlignment="Center" Margin="8,0,0,0"
                                            Style="{StaticResource SettingsButton}"
                                            Padding="10,3" FontSize="12" Content="⋯"
                                            ToolTip="更多" Click="EditorMenu_Click" />
                                </Grid>

                                <!-- Editable fields for user scenes. -->
                                <StackPanel x:Name="EditFields" Margin="0,14,0,0">
                                    <TextBlock Text="名称" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource InkSecondaryColor}" />
                                    <TextBox x:Name="EditName" Margin="0,5,0,0" Padding="8,5"
                                             FontSize="12" LostFocus="EditField_LostFocus" />
                                    <TextBlock Margin="0,12,0,0" Text="说明" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkSecondaryColor}" />
                                    <TextBox x:Name="EditSummary" Margin="0,5,0,0" Padding="8,5"
                                             FontSize="12" LostFocus="EditField_LostFocus" />
                                    <TextBlock Margin="0,12,0,0" Text="提示词" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkSecondaryColor}" />
                                    <TextBox x:Name="EditPrompt" Margin="0,5,0,0" Padding="8,6"
                                             FontSize="12" MinHeight="110" AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             LostFocus="EditField_LostFocus" />
                                </StackPanel>

                                <!-- Official templates stay read-only. -->
                                <StackPanel x:Name="ReadFields" Visibility="Collapsed"
                                            Margin="0,14,0,0">
                                    <TextBlock Text="名称" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource InkSecondaryColor}" />
                                    <Border Margin="0,5,0,0" Padding="10,8" CornerRadius="6"
                                            Background="{StaticResource SunkenColor}">
                                        <TextBlock x:Name="ReadName" FontSize="12.5"
                                                   Foreground="{StaticResource InkColor}" />
                                    </Border>
                                    <TextBlock Margin="0,12,0,0" Text="说明" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkSecondaryColor}" />
                                    <Border Margin="0,5,0,0" Padding="10,8" CornerRadius="6"
                                            Background="{StaticResource SunkenColor}">
                                        <TextBlock x:Name="ReadSummary" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkColor}" />
                                    </Border>
                                    <TextBlock Margin="0,12,0,0" Text="提示词" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkSecondaryColor}" />
                                    <Border Margin="0,5,0,0" Padding="10,8" CornerRadius="6"
                                            Background="{StaticResource SunkenColor}">
                                        <!-- Read-only TextBox: selectable text like macOS .textSelection(.enabled). -->
                                        <TextBox x:Name="ReadPrompt" FontSize="12" IsReadOnly="True"
                                                 TextWrapping="Wrap" BorderThickness="0"
                                                 Background="Transparent" Padding="0"
                                                 Foreground="{StaticResource InkColor}" />
                                    </Border>
                                </StackPanel>

                                <!-- 适用 Agent -->
                                <StackPanel Margin="0,18,0,0">
                                    <TextBlock Text="适用 Agent" FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkSecondaryColor}" />
                                    <TextBlock Margin="0,3,0,8" FontSize="11"
                                               Foreground="{StaticResource InkTertiaryColor}"
                                               Text="仅在转发到已选择的 Agent 时使用这个提示词。" />
                                    <ItemsControl x:Name="AgentGrid">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0,0,14,8" FontSize="12"
                                                          Foreground="{StaticResource InkColor}"
                                                          Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                          IsEnabled="{Binding Editable}"
                                                          Click="AgentCheck_Click" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Grid x:Name="OfficialHint" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="11" VerticalAlignment="Center"
                                               Foreground="{StaticResource InkSecondaryColor}"
                                               Text="官方模板保持只读，复制后可以修改。" />
                                    <Button Grid.Column="1" Style="{StaticResource SettingsButton}"
                                            Padding="10,3" FontSize="11.5" Content="复制并编辑"
                                            Click="Duplicate_Click" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- =============== 群聊匹配 page =============== -->
            <Grid x:Name="GroupsPage" Margin="0,10,0,0" MinHeight="480" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Group list card. -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="14,12" Orientation="Horizontal">
                            <TextBlock Text="群聊" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkColor}" />
                            <TextBlock x:Name="GroupCount" Margin="6,0,0,0" FontSize="11"
                                       Foreground="{StaticResource InkTertiaryColor}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBox x:Name="GroupSearch" Grid.Row="1" Margin="14,0,14,8"
                                 Padding="8,5" FontSize="12" ToolTip="搜索群聊"
                                 TextChanged="GroupSearch_TextChanged" />
                        <Border Grid.Row="2" Height="1" Background="{StaticResource StrokeSoftColor}" />

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                      MaxHeight="430">
                            <StackPanel>
                                <TextBlock x:Name="BoundHeader" Margin="14,10,14,4" FontSize="11"
                                           Foreground="{StaticResource InkTertiaryColor}"
                                           Text="已绑定" />
                                <ItemsControl x:Name="BoundGroupList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LinkButton}"
                                                    HorizontalContentAlignment="Stretch"
                                                    HorizontalAlignment="Stretch"
                                                    Tag="{Binding Selected}"
                                                    Click="GroupRow_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="row" Padding="14,9"
                                                                Background="Transparent">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding NameText}"
                                                                           FontSize="12.5" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource InkColor}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Margin="0,2,0,0" FontSize="11"
                                                                           Foreground="{StaticResource InkSecondaryColor}"
                                                                           Text="{Binding BindingText}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                <Setter TargetName="row" Property="Background" Value="{StaticResource BrandTintColor}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="row" Property="Background" Value="{StaticResource HoverColor}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="UnboundHeader" Margin="14,10,14,4" FontSize="11"
                                           Foreground="{StaticResource InkTertiaryColor}"
                                           Text="尚未绑定" />
                                <ItemsControl x:Name="UnboundGroupList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource LinkButton}"
                                                    HorizontalContentAlignment="Stretch"
                                                    HorizontalAlignment="Stretch"
                                                    Tag="{Binding Selected}"
                                                    Click="GroupRow_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="row" Padding="14,9"
                                                                Background="Transparent">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding NameText}"
                                                                           FontSize="12.5" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource InkColor}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Margin="0,2,0,0" FontSize="11"
                                                                           Foreground="{StaticResource InkSecondaryColor}"
                                                                           Text="{Binding BindingText}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                <Setter TargetName="row" Property="Background" Value="{StaticResource BrandTintColor}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="row" Property="Background" Value="{StaticResource HoverColor}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Binding editor — the port of GroupBindingEditor. -->
                <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel x:Name="GroupEmpty" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="还没有群聊记录" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkColor}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource InkSecondaryColor}"
                                       Text="从微信转发一次后，就可以在这里为群聊绑定场景。"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer x:Name="GroupEditor" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="GroupTitle" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkColor}" />
                                <TextBlock x:Name="GroupBoundCount" Margin="0,3,0,0" FontSize="11"
                                           Foreground="{StaticResource InkSecondaryColor}" />

                                <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="6"
                                        Background="{StaticResource BrandTintColor}">
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{StaticResource LiveInkColor}"
                                               Text="每次转发只加载其中一个场景；不适用当前 Agent 的场景会自动跳过。" />
                                </Border>

                                <TextBlock Margin="0,14,0,0" Text="可选场景" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkColor}" />
                                <TextBlock Margin="0,3,0,8" FontSize="11"
                                           Foreground="{StaticResource InkTertiaryColor}"
                                           Text="勾选这个群聊可使用的场景；转发时再选择其中一个。" />

                                <ItemsControl x:Name="BoundSceneList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="0,5" Click="BoundSceneCheck_Click"
                                                      IsChecked="{Binding IsBound, Mode=OneWay}">
                                                <StackPanel Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding NameText}" FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource InkColor}" />
                                                    <TextBlock FontSize="11" Text="{Binding SummaryText}"
                                                               Foreground="{StaticResource InkSecondaryColor}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="10.5" Text="{Binding AgentsText}"
                                                               Foreground="{StaticResource InkTertiaryColor}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel x:Name="DisabledScenesNote" Margin="0,14,0,0"
                                            Visibility="Collapsed">
                                    <TextBlock Text="已关闭的场景" FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkColor}" />
                                    <TextBlock x:Name="DisabledSceneNames" Margin="0,3,0,0"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource InkSecondaryColor}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="11"
                                               Foreground="{StaticResource InkTertiaryColor}"
                                               Text="启用后才能绑定到群聊。" />
                                </StackPanel>

                                <Button x:Name="ClearBindingButton" Margin="0,14,0,0"
                                        Style="{StaticResource SettingsButton}" Padding="10,3"
                                        FontSize="11.5" Content="取消绑定"
                                        HorizontalAlignment="Right"
                                        Click="ClearBinding_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Notice bar — the macOS SceneNotice line. -->
            <Border x:Name="NoticeBar" Margin="0,12,0,0" Padding="12,8" CornerRadius="6"
                    Background="{StaticResource LiveFillColor}" Visibility="Collapsed">
                <TextBlock x:Name="NoticeText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource LiveInkColor}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
