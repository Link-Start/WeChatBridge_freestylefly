<UserControl x:Class="WeChatBridge.Windows.Panes.AboutPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="720">
        <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkColor}"
                   Text="微信流" />
        <TextBlock x:Name="VersionText" Margin="0,6,0,0" FontSize="12"
                   Foreground="{StaticResource InkSecondaryColor}" />

        <Border Height="1" Background="{StaticResource StrokeSoftColor}" Margin="0,16" />

        <TextBlock FontSize="13" Foreground="{StaticResource InkColor}"
                   Text="在微信的转发菜单里，直接把聊天记录送到你要用的地方。"
                   TextWrapping="Wrap" />

        <Border Height="1" Background="{StaticResource StrokeSoftColor}" Margin="0,16" />

        <TextBlock FontSize="13" Foreground="{StaticResource InkSecondaryColor}"
                   Text="在 GitHub 上查看项目，或向我们提交建议与问题。"
                   TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource SettingsButton}" Click="OpenProject_Click">访问项目</Button>
            <Button Style="{StaticResource SettingsButton}" Margin="8,0,0,0" Click="OpenIssues_Click">提交反馈</Button>
        </StackPanel>
    </StackPanel>
</UserControl>
