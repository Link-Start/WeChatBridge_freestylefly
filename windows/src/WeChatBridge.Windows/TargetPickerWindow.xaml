<Window x:Class="WeChatBridge.Windows.TargetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发给…" Width="260" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Padding="10" Background="#F9FAFB" CornerRadius="10"
            BorderBrush="#D0D5DD" BorderThickness="1">
        <StackPanel>
            <Grid Margin="4,0,4,8">
                <StackPanel>
                    <TextBlock Text="发给…" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="回车或点击应用，Esc 取消。" Foreground="#667085" FontSize="11" />
                </StackPanel>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="22" Height="22" Padding="0" Content="✕"
                        BorderThickness="0" Background="Transparent" Foreground="#98A2B3"
                        ToolTip="关闭" Click="OnCloseClicked" />
            </Grid>
            <ListBox x:Name="TargetList" MaxHeight="256" BorderThickness="0"
                     Background="Transparent" SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseLeftButtonUp" Handler="OnRowClicked" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Mark" Text="○" Width="20" VerticalAlignment="Center"
                                       Foreground="#98A2B3" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Shortcut}" FontSize="10"
                                       VerticalAlignment="Center" Foreground="#98A2B3" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         Value="True">
                                <Setter TargetName="Mark" Property="Text" Value="●" />
                                <Setter TargetName="Mark" Property="Foreground" Value="#2E7FD9" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
