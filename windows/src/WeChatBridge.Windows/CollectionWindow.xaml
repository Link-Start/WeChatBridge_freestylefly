<Window x:Class="WeChatBridge.Windows.CollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WeChatBridge.Windows"
        Title="{loc:Loc Key='分批收集到微信流'}" Width="710" Height="650" MinWidth="620" MinHeight="500"
        Background="{StaticResource BackgroundColor}" Topmost="True">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource InkColor}"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource MacField}"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{loc:Loc Key='分批收集'}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,12" TextWrapping="Wrap"
                       Text="{loc:Loc Key='在微信中手动选择每批消息，继续转发到「分批收集到微信流」。原始 ZIP 保持完整，完成时统一选择目标和场景。'}"/>
            <ComboBox x:Name="CollectionList" DisplayMemberPath="Label" SelectedValuePath="Id"
                      SelectionChanged="CollectionList_SelectionChanged"/>
            <TextBox x:Name="CollectionName" Margin="0,8,0,0" ToolTip="{loc:Loc Key='这组收集的名称'}"
                     LostFocus="CollectionName_LostFocus"/>
            <TextBlock x:Name="Status" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,12">
            <Button x:Name="ResumeButton" Content="{loc:Loc Key='继续收集'}" Click="Resume_Click" Margin="0,0,8,0"/>
            <Button x:Name="UndoButton" Content="{loc:Loc Key='撤销删除'}" Click="Undo_Click" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc Key='查看原始文件'}" Click="Reveal_Click"/>
        </WrapPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BatchList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{loc:Loc Key='删除（可撤销）'}" Click="Remove_Click"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{loc:Loc Key='群或联系人名称'}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding ChatName, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="ChatName_LostFocus"/>
                                <CheckBox Content="{loc:Loc Key='用于本组未命名和后续批次'}" IsChecked="{Binding IsDefault}" Margin="0,6,0,0" Click="DefaultName_Click"/>
                                <Expander Header="{loc:Loc Key='查看边界（首尾消息参考）'}" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Boundaries}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" x:Name="DeliverButton" Style="{StaticResource PrimaryButton}" Content="{loc:Loc Key='完成并交付…'}" Click="Deliver_Click"/>
            <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
