<Window x:Class="WeChatBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panes="clr-namespace:WeChatBridge.Windows.Panes"
        Title="微信流" Height="620" Width="960"
        MinHeight="420" MinWidth="760">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- The navigation column runs the full height of the window, like the macOS settings window. -->
            <ColumnDefinition Width="168" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SunkenColor}">
            <StackPanel Margin="10,18">
                <TextBlock Margin="10,0,0,14" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource InkColor}" Text="微信流" />
                <ListBox x:Name="NavList" BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="11,7" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="FontSize" Value="13.5" />
                            <Setter Property="Foreground" Value="{StaticResource InkSecondaryColor}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="row" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{StaticResource BrandTintColor}" />
                                                <Setter Property="Foreground" Value="{StaticResource InkColor}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{StaticResource HoverColor}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem Tag="History">记录</ListBoxItem>
                    <ListBoxItem Tag="General">通用</ListBoxItem>
                    <ListBoxItem Tag="Entries">入口</ListBoxItem>
                    <ListBoxItem Tag="About">关于</ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PaneTitle" Margin="28,20,28,0" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource InkColor}" Text="记录" />
            <Border Grid.Row="1" Margin="28,14,28,20">
                <ContentControl x:Name="PaneHost" />
            </Border>

            <!-- Transient status capsule — the in-window port of ToastPresenter. -->
            <Border x:Name="Toast" Grid.RowSpan="2"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,14,18,0" Padding="14,10" CornerRadius="8"
                    Background="#FFFCFCFD" BorderBrush="{StaticResource StrokeColor}" BorderThickness="1"
                    Visibility="Collapsed" MaxWidth="380"
                    MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.18" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource InkColor}" TextWrapping="Wrap"
                               MaxWidth="300" />
                    <Button x:Name="ToastAction" Margin="10,0,0,0" Padding="6,2" FontSize="12"
                            Foreground="{StaticResource BrandColor}" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Click="ToastAction_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
